<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#101b2c"><title>Control de Almacén | Registro de Operaciones</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:#152339;background:#edf2f7}*{box-sizing:border-box}html{overflow-y:scroll;scrollbar-gutter:stable;scroll-behavior:smooth}body{margin:0;min-height:100vh;overflow-y:visible;background:radial-gradient(circle at top right,#d6e8f1,transparent 38%),linear-gradient(150deg,#f4f7fb,#e6edf4)}header{background:#101b2c;color:white;padding:22px 18px;border-bottom:4px solid #18a783}.wrap{max-width:1000px;margin:auto}.brand{display:flex;gap:13px;align-items:center}.logo{display:grid;place-items:center;background:#1aaf8e;color:#fff;width:46px;height:46px;border-radius:13px;font-size:26px}h1{font-size:22px;margin:0}header p{margin:4px 0 0;color:#b9c7d8;font-size:13px}main{padding:25px 16px 50px}.layout{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}.panel{background:white;border:1px solid #dfe6ee;border-radius:18px;box-shadow:0 12px 30px #1b34500b;padding:24px}.panel h2{font-size:18px;margin:0 0 7px}.hint{color:#6d7b8d;font-size:13px;margin:0 0 23px}.section{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#087e68;margin:24px 0 13px;border-bottom:1px solid #e8edf2;padding-bottom:10px}.section:first-of-type{margin-top:0}.field{margin-bottom:15px}label{display:block;font-size:13px;font-weight:650;margin-bottom:7px}.two{display:grid;grid-template-columns:1fr 1fr;gap:13px}input,select{width:100%;height:44px;border:1px solid #cfd9e3;border-radius:9px;padding:0 12px;background:#fff;font:inherit;font-size:14px;color:#172b43}input:focus,select:focus{outline:2px solid #8ed9ca;border-color:#138b74}.vehicle-fields[hidden]{display:none!important}.plate-row{display:flex;gap:7px}.plate-row select{flex:1;min-width:0}.mini{border:1px solid #cad7e3;background:#f4f8fb;border-radius:9px;padding:0 10px;font-size:13px;font-weight:700}.mini.danger{color:#b13535}.km-box{background:#f0faf6;border:1px solid #b9e2d2;border-radius:12px;padding:15px;margin:12px 0 18px}.km-box input{font-size:19px;font-weight:750}.photo-preview{max-width:100%;max-height:190px;object-fit:contain;border-radius:10px;margin-top:9px}.small{font-size:12px;color:#64748b;margin:6px 0}.image-actions{display:grid;gap:8px;margin-top:8px}.time-row{display:flex;gap:8px}.time-row input{flex:1;min-width:0}.now{border:1px solid #b8dcd4;background:#edf9f5;color:#08745e;border-radius:9px;padding:0 12px;font-weight:700;cursor:pointer;white-space:nowrap}.actions{display:grid;gap:9px;margin-top:22px}button{font:inherit;cursor:pointer}.primary{background:#087f65;color:white;border:0;border-radius:10px;padding:14px;font-weight:800}.primary:hover{background:#066b55}.secondary{background:white;border:1px solid #cad7e3;border-radius:10px;padding:12px;color:#23364a;font-weight:700}.preview{white-space:pre-wrap;line-height:1.75;background:#eaf5ef;border:1px solid #d2e9dc;padding:19px;border-radius:12px;font-size:14px;overflow-wrap:anywhere}.sticky{position:sticky;top:20px;align-self:start}.note{font-size:12px;color:#65758a;line-height:1.55;margin-top:13px}.pill{display:inline-block;background:#dff6ee;color:#06755e;padding:5px 10px;border-radius:30px;font-size:12px;font-weight:750;margin-bottom:14px}.toast{min-height:20px;color:#08745e;font-size:13px;font-weight:600}footer{text-align:center;font-size:12px;color:#728095;padding:0 15px 25px}@media(max-width:760px){.layout{grid-template-columns:1fr}.sticky{position:static}.panel{padding:18px}.two{grid-template-columns:1fr 1fr}h1{font-size:19px}}@media(max-width:360px){.two{grid-template-columns:1fr}.time-row{flex-wrap:wrap}.now{height:42px}}
html::-webkit-scrollbar{width:12px}html::-webkit-scrollbar-track{background:#e2eaf2}html::-webkit-scrollbar-thumb{background:#8195aa;border:3px solid #e2eaf2;border-radius:12px}html::-webkit-scrollbar-thumb:hover{background:#526d88}</style></head><body>
<header><div class="wrap brand"><div class="logo">🚛</div><div><h1>Control de Almacén</h1><p>Registro de tiempos · Carga y descarga</p></div></div></header>
<main class="wrap"><div class="layout"><section class="panel"><h2>Nuevo registro</h2><p class="hint">Completa los datos y comparte el reporte por WhatsApp.</p><form id="form"><div class="section">Información general</div><div class="field"><label for="nombre">Nombre del conductor *</label><input id="nombre" required autocomplete="name" placeholder="Nombres y apellidos"></div><div class="two"><div class="field"><label for="fecha">Fecha *</label><input type="date" id="fecha" required></div><div class="field"><label for="tipo">Motivo *</label><select id="tipo"><option value="CARGA">Carga</option><option value="DESCARGA">Descarga</option></select></div></div><div class="section">Kilometraje y ruta</div><div class="km-box"><div class="field"><label for="km">Kilometraje actual (km) *</label><input id="km" type="number" min="0" max="99999999" step="1" inputmode="numeric" required placeholder="Ej. 125480"></div><label for="foto">Fotografía del tablero mostrando el kilometraje *</label><input id="foto" type="file" accept="image/*" capture="environment" required><div class="small">Toma o adjunta una fotografía donde se vea claramente el kilometraje.</div><img id="fotoPreview" class="photo-preview" hidden alt="Vista previa del kilometraje"><button class="mini" type="button" id="clearPhoto" hidden>Quitar fotografía</button></div><div class="two"><div class="field"><label for="origen">Inicio de ruta *</label><input id="origen" required placeholder="Ej. Huachipa"></div><div class="field"><label for="destino">Destino de ruta *</label><input id="destino" required placeholder="Ej. Cajamarca"></div></div><div class="section">Unidad de transporte</div><div class="field"><label for="vehiculo">Tipo de vehículo *</label><select id="vehiculo"><option value="TRACTO">Tracto + acoplado</option><option value="CAMION">Camión</option></select></div><div class="two vehicle-fields" id="camposTracto"><div class="field"><label for="tracto">Placa de tracto *</label><div class="plate-row"><select id="tracto" required></select><button type="button" class="mini" data-add="tracto" title="Agregar placa">＋</button><button type="button" class="mini danger" data-del="tracto" title="Eliminar placa">−</button></div></div><div class="field"><label for="acoplado">Placa de acoplado *</label><div class="plate-row"><select id="acoplado" required></select><button type="button" class="mini" data-add="acoplado" title="Agregar placa">＋</button><button type="button" class="mini danger" data-del="acoplado" title="Eliminar placa">−</button></div></div></div><div class="field vehicle-fields" id="camposCamion" hidden><label for="camion">Placa de camión *</label><div class="plate-row"><select id="camion"></select><button type="button" class="mini" data-add="camion" title="Agregar placa">＋</button><button type="button" class="mini danger" data-del="camion" title="Eliminar placa">−</button></div></div><div class="section">Control de horarios</div><p class="hint">Deja vacíos los horarios que aún no se hayan producido.</p><div id="times"></div><div class="actions"><button class="primary" type="submit">📷 Compartir reporte y foto por WhatsApp</button><button class="secondary" type="button" id="textOnly">💬 Abrir WhatsApp solo con el texto</button><button class="secondary" type="button" id="copy">📋 Copiar mensaje</button><button class="secondary" type="button" id="reset">↺ Nuevo registro</button><div class="toast" id="toast" aria-live="polite"></div></div></form></section><aside class="panel sticky"><span class="pill">● Vista previa en tiempo real</span><h2>Mensaje para WhatsApp</h2><p class="hint">Los campos se muestran siempre en el mismo orden.</p><div class="preview" id="preview"></div><p class="note">En móviles compatibles, el botón Compartir permite enviar la foto y el texto juntos mediante el menú del dispositivo. Elige WhatsApp y después el grupo. Si tu dispositivo no admite compartir ambos juntos, envía la fotografía manualmente y usa el botón de texto. Nunca se envía automáticamente.</p></aside></div></main><footer>Control operativo de almacén · Formulario local sin servidor</footer>
<script>
const fields=[['llegada','Hora de llegada'],['rampa','Hora de ingreso a la rampa'],['inicio','Hora de inicio de carga'],['fin','Hora de fin de carga'],['salida','Hora de salida de almacén']];
const $=id=>document.getElementById(id),v=id=>$(id).value.trim(),pad=n=>String(n).padStart(2,'0');
const today=()=>{const d=new Date();return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`};$('fecha').value=today();
$('times').innerHTML=fields.map(([id,label])=>`<div class="field"><label for="${id}">${label}</label><div class="time-row"><input type="time" id="${id}"><button class="now" type="button" data-now="${id}">◷ Hora actual</button></div></div>`).join('');
const keys={tracto:'almacen_placas_tracto_v4',acoplado:'almacen_placas_acoplado_v4',camion:'almacen_placas_camion_v4'};
function plates(id){try{return JSON.parse(localStorage.getItem(keys[id])||'[]')}catch{return []}}
function refreshPlate(id,preferred){const list=plates(id),sel=$(id);sel.innerHTML='<option value="">Selecciona una placa</option>';list.forEach(p=>{const o=document.createElement('option');o.value=p;o.textContent=p;sel.appendChild(o)});sel.value=preferred&&list.includes(preferred)?preferred:'';render()}
function savePlate(id,list,selected){try{localStorage.setItem(keys[id],JSON.stringify(list))}catch{alert('El navegador no pudo guardar las placas. Verifica el almacenamiento local.')}refreshPlate(id,selected)}
['tracto','acoplado','camion'].forEach(id=>refreshPlate(id));
document.querySelectorAll('[data-add]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.add;let p=prompt('Ingresa la nueva placa de '+(id==='camion'?'camión':id)+':');if(p===null)return;p=p.trim().toUpperCase().replace(/\s+/g,'');if(!/^[A-Z0-9-]{5,12}$/.test(p)){alert('Ingresa una placa válida de 5 a 12 caracteres (letras, números o guion).');return}const list=plates(id);if(list.includes(p)){alert('La placa ya existe.');$(id).value=p;render();return}list.push(p);list.sort();savePlate(id,list,p)}));
document.querySelectorAll('[data-del]').forEach(b=>b.addEventListener('click',()=>{const id=b.dataset.del,p=v(id);if(!p){alert('Selecciona primero una placa.');return}if(confirm('¿Eliminar la placa '+p+' de la lista guardada?'))savePlate(id,plates(id).filter(x=>x!==p),'')}));
function syncVehicle(){const c=v('vehiculo')==='CAMION';$('camposTracto').hidden=c;$('camposCamion').hidden=!c;$('tracto').required=!c;$('acoplado').required=!c;$('camion').required=c;render()}
$('vehiculo').addEventListener('change',syncVehicle);
function dateFormat(x){if(!x)return 'PENDIENTE';const [y,m,d]=x.split('-');return `${d}/${m}/${y}`}
function msg(){return `🚛 *CONTROL DE ALMACÉN*\n\n📋 *Motivo:* ${v('tipo')}\n👤 *Conductor:* ${v('nombre')||'PENDIENTE'}\n📅 *Fecha:* ${dateFormat(v('fecha'))}\n📍 *Inicio de ruta:* ${v('origen')||'PENDIENTE'}\n🏁 *Destino de ruta:* ${v('destino')||'PENDIENTE'}\n🛣️ *Kilometraje:* ${v('km')||'PENDIENTE'} km\n${v('vehiculo')==='CAMION'?`🚚 *Placa de camión:* ${v('camion')||'PENDIENTE'}`:`🚛 *Placa de tracto:* ${v('tracto')||'PENDIENTE'}\n🚚 *Placa de acoplado:* ${v('acoplado')||'PENDIENTE'}`}\n\n⏱️ *CONTROL DE HORARIOS*\n${fields.map(([id,label])=>`• ${label}: ${v(id)||'PENDIENTE'}`).join('\n')}\n\n📷 *Evidencia:* Fotografía del kilometraje`}
function render(){$('preview').textContent=msg()}
let photoUrl=null;function showPhoto(){if(photoUrl)URL.revokeObjectURL(photoUrl);photoUrl=null;const f=$('foto').files[0];$('fotoPreview').hidden=!f;$('clearPhoto').hidden=!f;if(f){photoUrl=URL.createObjectURL(f);$('fotoPreview').src=photoUrl}else $('fotoPreview').removeAttribute('src');render()}
$('foto').addEventListener('change',showPhoto);$('clearPhoto').addEventListener('click',()=>{$('foto').value='';showPhoto()});
function toast(t){$('toast').textContent=t;setTimeout(()=>{$('toast').textContent=''},6000)}
function openText(){window.open('https://api.whatsapp.com/send?text='+encodeURIComponent(msg()),'_blank','noopener,noreferrer');toast('Selecciona el grupo en WhatsApp. Adjunta la foto del kilometraje manualmente.')}
$('form').addEventListener('submit',async e=>{e.preventDefault();if(!$('form').reportValidity())return;const f=$('foto').files[0];if(!f)return alert('Adjunta una foto del kilometraje.');if(navigator.share&&navigator.canShare&&navigator.canShare({files:[f]})){try{await navigator.share({files:[f],text:msg(),title:'Control de Almacén'});toast('Compartido mediante el menú del dispositivo. Verifica que el grupo haya recibido el texto y la foto.');return}catch(err){if(err.name==='AbortError')return}}toast('Este navegador no permite compartir la foto y el texto juntos. Descarga o conserva la imagen y envíala manualmente al mismo grupo.');openText()});
$('textOnly').addEventListener('click',openText);
$('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(msg());toast('Mensaje copiado.')}catch{const t=document.createElement('textarea');t.value=msg();document.body.append(t);t.select();document.execCommand('copy');t.remove();toast('Mensaje copiado.')}});
document.querySelectorAll('[data-now]').forEach(b=>b.addEventListener('click',()=>{const d=new Date();$(b.dataset.now).value=`${pad(d.getHours())}:${pad(d.getMinutes())}`;render()}));
$('form').addEventListener('input',render);$('form').addEventListener('change',render);
$('reset').addEventListener('click',()=>{if(!confirm('¿Limpiar el formulario? Las placas guardadas permanecerán disponibles.'))return;$('form').reset();$('fecha').value=today();showPhoto();syncVehicle();toast('Nuevo registro listo.')});syncVehicle();
</script></body></html>
